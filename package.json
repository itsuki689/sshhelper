{
  "name": "airsftp",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal SSH/SFTP file transfer assistant",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "build:portable": "set PKG_CACHE_PATH=.pkg-cache&& pkg . --targets node22-win-x64 --output dist/AirSFTP.exe --compress Brotli"
  },
  "dependencies": {
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.22.0"
  },
  "pkg": {
    "assets": [
      "index.html",
      "styles.css",
      "app.js"
    ]
  }
}
